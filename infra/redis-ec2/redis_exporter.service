[Unit]
Description=Redis Exporter
After=network.target redis.service

[Service]
Environment=REDIS_ADDR=redis://localhost:6379
# Redis 에 requirepass 가 걸려 있으면 반드시 필요하다 — 없으면 스크레이프가 전부
# "NOAUTH Authentication required" 로 조용히 실패한다. Prometheus 의 up 지표는 그래도
# 정상(1)으로 보인다(9121 포트 자체는 응답하니까, exporter 프로세스는 떠 있다) — 그래서
# 대시보드가 텅 비어도 한참 못 알아챌 수 있다(실제로 8일간 이 상태였다, 2026-08-11).
# 걸려 있으면 아래 주석을 풀고 앱이 쓰는 것과 같은 REDIS_PASSWORD 값을 채운다
# (앱 서버의 systemd EnvironmentFile 에서 확인 — 흩어져 있을 수 있으니
# `sudo systemctl show myapp -p EnvironmentFile` 로 먼저 위치를 찾을 것):
#Environment=REDIS_PASSWORD=<비밀번호>
ExecStart=/usr/local/bin/redis_exporter
Restart=always

[Install]
WantedBy=multi-user.target
