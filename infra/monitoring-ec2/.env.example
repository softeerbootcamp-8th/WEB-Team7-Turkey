# cp .env.example .env 후 실제 값 채우기. .env는 커밋하지 않는다.
GRAFANA_ADMIN_PASSWORD=change-me

# mysqld_exporter 접속정보는 여기가 아니라 .my.cnf.example -> .my.cnf 로 채운다
# (PROCESS, REPLICATION CLIENT 권한만 있는 읽기전용 계정).

# 팀원이 브라우저에 입력할 주소. 자체서명 인증서의 주체가 되므로 반드시 채운다
# (IP 도 가능: https://10.0.20.30). 도메인이 생기면 그 도메인으로 바꾸고 Caddyfile 의
# `tls internal` 줄을 지우면 Let's Encrypt 로 전환된다.
SITE_ADDRESS=https://<모니터링-EC2-주소>
